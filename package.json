{
  "name": "takt",
  "private": true,
  "scripts": {
    "dev": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "db:up": "docker compose up db -d",
    "db:down": "docker compose stop db",
    "migrate": "cd backend && alembic upgrade head",
    "backend": "cd backend && ./.venv/bin/uvicorn app.main:app --reload --port 8000",
    "setup:local": "npm run db:up && npm run migrate"
  }
}
