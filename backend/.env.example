# Копируйте в backend/.env или используйте .env в корне репозитория (подхватится автоматически)

DATABASE_URL=postgresql+asyncpg://track:track_dev_pass@localhost:5433/track
SECRET_KEY=local-dev-secret-key-change-in-prod-32chars
ENV=development
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMeAdmin123!
ADMIN_NAME=Администратор
UPLOAD_DIR=./data/uploads
SEED_DEMO_DATA=true

# OAuth — docs/OAUTH_SETUP.md
OAUTH_OPERATOR_REGION=unset
OAUTH_APPLE_ENABLED=false
OAUTH_APPLE_ALLOWED_FOR_RU_OPERATOR=false
OAUTH_VK_ENABLED=false
OAUTH_YANDEX_ENABLED=false
