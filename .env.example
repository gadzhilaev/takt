# === Общие ===
DOMAIN=localhost
HTTP_PORT=80
HTTPS_PORT=443
ACME_EMAIL=admin@example.com

# Префикс Docker Compose (контейнеры/volumes). Оставьте track, если уже есть
# volume track_pgdata — иначе после переименования папки в takt поднимется пустая БД.
COMPOSE_PROJECT_NAME=track

# === PostgreSQL ===
# Имена пользователя/БД — технические идентификаторы (совместимость с существующими volumes).
POSTGRES_USER=track
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=track
# Порт Postgres на хосте (Docker). 5433 — чтобы не мешать локальному PostgreSQL на 5432 (Windows)
POSTGRES_HOST_PORT=5433

# Локальная разработка: сначала `docker compose up db -d`
DATABASE_URL=postgresql+asyncpg://track:change_me_strong_password@localhost:5433/track

# === Backend ===
SECRET_KEY=change_me_random_string_at_least_32_chars
ENV=production
DEBUG=false
COOKIE_SECURE=true
COOKIE_DOMAIN=
CORS_ORIGINS=https://your-domain.example

# Первый администратор (создаётся только если в БД нет админов)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMeAdmin123!
ADMIN_NAME=Администратор

# Демо-данные при старте (true/false). Demo projects are is_demo and hidden from non-members.
SEED_DEMO_DATA=false

# Isolated demo login (used by scripts/setup_demo_workspace.py). Do not commit real passwords.
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=

LOGIN_LOCKOUT_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Web Push (VAPID). Generate: npx web-push generate-vapid-keys
# Keep VAPID_PRIVATE_KEY server-side only — never commit real keys.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
APP_PUBLIC_URL=http://localhost:3000

# Mobile FCM (service-account JSON path — never commit the file)
FCM_ENABLED=false
FIREBASE_CREDENTIALS_FILE=

# Email OTP (registration + change password)
# Prefer classic SMTP (smtp.bz connect). HTTP API optional if domain verified there.
SMTP_HOST=connect.smtp.bz
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_BZ_API_KEY=
SMTP_FROM_EMAIL=Takt <noreply@taktapp.ru>
EMAIL_CODE_TTL_MINUTES=10
EMAIL_CODE_RESEND_SECONDS=60

# === OAuth (server-side secrets only; never put in Flutter/Next public env) ===
# See docs/OAUTH_SETUP.md for Apple / VK ID / Яндекс ID registration steps.
OAUTH_OPERATOR_REGION=unset
# If operator is in RU (149-FZ ч.10 ст.8), keep Apple off until legal clearance:
# OAUTH_OPERATOR_REGION=ru
# OAUTH_APPLE_ALLOWED_FOR_RU_OPERATOR=false
OAUTH_APPLE_ENABLED=false
OAUTH_APPLE_ALLOWED_FOR_RU_OPERATOR=false
OAUTH_APPLE_CLIENT_ID=
OAUTH_APPLE_TEAM_ID=
OAUTH_APPLE_KEY_ID=
OAUTH_APPLE_PRIVATE_KEY=
OAUTH_APPLE_PRIVATE_KEY_FILE=
OAUTH_VK_ENABLED=false
OAUTH_VK_CLIENT_ID=
OAUTH_VK_CLIENT_SECRET=
OAUTH_YANDEX_ENABLED=false
OAUTH_YANDEX_CLIENT_ID=
OAUTH_YANDEX_CLIENT_SECRET=
OAUTH_WEB_REDIRECT_URI=http://localhost:3000/api/v1/auth/oauth/callback
OAUTH_MOBILE_REDIRECT_URI=takt://oauth/callback
OAUTH_ALLOWED_REDIRECT_URIS=http://localhost:3000/api/v1/auth/oauth/callback,https://taktapp.ru/api/v1/auth/oauth/callback,takt://oauth/callback

# === Frontend ===
NEXT_PUBLIC_API_URL=http://localhost/api
NEXT_PUBLIC_WS_URL=ws://localhost/ws
