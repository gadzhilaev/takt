{
	email {$ACME_EMAIL}
}

{$DOMAIN:localhost} {
	encode gzip

	handle /.well-known/oauth-* {
		reverse_proxy backend:8000
	}

	handle /oauth/* {
		reverse_proxy backend:8000
	}

	handle /mcp* {
		reverse_proxy backend:8000
	}

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle /ws {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:3000
	}
}
